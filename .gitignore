# OS generated file
# =================
.DS_Store

# Node and related ecosystem
# ==========================
.nodemonignore
npm-debug.log
node_modules/
lib/
mockgoose/
.pnpm-store/

# MEAN.js app and assets
# ======================
dist/

# API keys file
# ==============
!.ebextensions/*.config
*.env
*.pem
*.cert
*spcp-cert.pem
*formsg-cert.pem
*formsg-key.pem
*passphrase*
*.key

# MyInfo v5 dev RP keys — generated at container startup by
# `pnpm --filter formsg-backend gen-dev-rp-keys`. Private key material,
# never checked in.
.dev-keys/

# VSCode
# ==============
.dccache

# Sublime editor
# ==============
*.sublime-project
*.sublime-workspace

# IntelliJ editor
# ==============
.idea/

# General
# =======
*.log
*.csv
*.dat
*.out
*.pid
*.gz
*.tmp
*.bak
*.swp
logs/
build/
tmp/

# Elastic Beanstalk Files
# =======
.elasticbeanstalk/*
!.elasticbeanstalk/*.cfg.yml
!.elasticbeanstalk/*.global.yml

# Localstack
# =======
.localstack

